DATABASE_URL=./database.db
JWT_SECRET=change-this-to-a-long-random-string
PORT=5001
FRONTEND_URL=http://localhost:3000

# Supabase — lihat Settings > API di dashboard.supabase.com
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLIC_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Consultation booking
# Nomor WhatsApp tujuan konsultasi, format internasional tanpa tanda + (mis. 62812xxxxxxx).
# Isi di backend/.env lokal dan di environment variables server saat deploy.
# JANGAN menuliskan nomor sungguhan di berkas contoh ini — ia ter-commit.
PSIKOLOG_WHATSAPP_NUMBER=
PSIKOLOG_NAME=
CONSULTATION_ONLINE_PRICE=300000
CONSULTATION_OFFLINE_PRICE=350000
CONSULTATION_ONLINE_DURATION=50
CONSULTATION_OFFLINE_DURATION=60
